rules_version = '2';

// Encrypted backups (暗号化バックアップ) and any uploaded media live under the
// owner's uid; nobody else can read or write them. CLAUDE.md: サーバー接続情報は
// クラウドに送らない — only backups and media belong here.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
